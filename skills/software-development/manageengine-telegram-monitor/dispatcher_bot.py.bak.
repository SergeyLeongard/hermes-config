#!/usr/bin/env python3
import logging
import os
import tempfile
import json
from pathlib import Path
from typing import Optional, Tuple

import requests
from telegram import Update
from telegram.ext import Application, ContextTypes, MessageHandler, filters
from faster_whisper import WhisperModel

from monitor import process_message
from api_wrapper import ManageEngineAPI


logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(name)s: %(message)s")
log = logging.getLogger("dispatcher_bot")

TG_TOKEN = os.getenv("DISPATCHER_TELEGRAM_BOT_TOKEN", "").strip()
TARGET_CHAT_ID = int(os.getenv("DISPATCHER_TARGET_CHAT_ID", "0"))
TARGET_TOPIC_ID = int(os.getenv("DISPATCHER_TARGET_TOPIC_ID", "0"))
STT_MODEL_NAME = os.getenv("DISPATCHER_STT_MODEL", "base").strip() or "base"
CLASSIFIER_MODEL = os.getenv("DISPATCHER_CLASSIFIER_MODEL", "minimax/minimax-m2.5:free").strip()
CLASSIFIER_BASE_URL = os.getenv("DISPATCHER_CLASSIFIER_BASE_URL", "https://openrouter.ai/api/v1").strip()
CLASSIFIER_API_KEY = os.getenv(
    "DISPATCHER_CLASSIFIER_API_KEY",
    os.getenv("OPENAI_API_KEY", os.getenv("OPENROUTER_API_KEY", "")),
).strip()
CLASSIFIER_CONFIDENCE = float(os.getenv("DISPATCHER_CLASSIFIER_CONFIDENCE", "0.65"))

_stt_model = None
_pending_clarification = {}

CATEGORY_NAMES = {
    "601": "Принтера",
    "602": "ПК/Железо",
    "604": "ПО",
    "605": "Сеть",
    "606": "Почта",
    "607": "Доступ",
    "608": "Телефония",
    "610": "Веб-сайт",
    "611": "Безопасность",
    "612": "Прочее",
    "613": "ERP",
    "614": "IoT",
    "615": "VPN/RDS",
}

CATEGORY_IDS = sorted(CATEGORY_NAMES.keys())


def _username(update: Update) -> str:
    u = update.effective_user
    if not u:
        return "unknown"
    if u.username:
        return f"@{u.username}"
    full = (u.full_name or "").strip()
    return full or f"id{u.id}"


def _build_created_text(request_id: str, user_label: str, user_id: int, subject: str, category_id: str) -> str:
    udf = user_label if user_label.startswith("@") else f"@id{user_id}"
    category_name = CATEGORY_NAMES.get(category_id, "Прочее")
    return (
        f"Заявка №{request_id} создана\n"
        f"👤 Пользователь: {user_label} (ID: {user_id})\n"
        f"📝 Тема: {subject[:100]}\n"
        f"🏷 Категория: {category_name} ({category_id})\n"
        f"🆔 UDF поле (IDUserTelegram): {udf}"
    )


def _classify_with_llm(text: str) -> Tuple[Optional[bool], Optional[str], float]:
    if not CLASSIFIER_API_KEY:
        return None, None, 0.0

    prompt = (
        "Ты классификатор сообщений для IT-диспетчера. Верни только JSON без markdown и комментариев. "
        "Поля: is_it (boolean), category_id (строка), confidence (число 0..1). "
        f"Допустимые category_id: {', '.join(CATEGORY_IDS)}. "
        "Если сообщение не про IT-инцидент/запрос IT-поддержки, ставь is_it=false, category_id='612'. "
        "Если не уверен, ставь confidence<0.65."
    )

    payload = {
        "model": CLASSIFIER_MODEL,
        "temperature": 0,
        "messages": [
            {"role": "system", "content": prompt},
            {"role": "user", "content": text[:1200]},
        ],
        "response_format": {"type": "json_object"},
    }
    headers = {
        "Authorization": f"Bearer {CLASSIFIER_API_KEY}",
        "Content-Type": "application/json",
    }

    try:
        r = requests.post(f"{CLASSIFIER_BASE_URL}/chat/completions", headers=headers, json=payload, timeout=20)
        r.raise_for_status()
        data = r.json()
        content = data.get("choices", [{}])[0].get("message", {}).get("content")
        if not content:
            return None, None, 0.0
        parsed = json.loads(content)
        is_it = parsed.get("is_it")
        if isinstance(is_it, str):
            is_it = is_it.strip().lower() in {"1", "true", "yes", "да"}
        elif not isinstance(is_it, bool):
            is_it = None
        cat = str(parsed.get("category_id", "612"))
        conf = float(parsed.get("confidence", 0.0))
        if cat not in CATEGORY_NAMES:
            cat = "612"
        return is_it, cat, conf
    except Exception:
        log.exception("LLM classifier failed")
        return None, None, 0.0


async def _attach_message_images(update: Update, request_id: str) -> None:
    msg = update.effective_message
    if not msg:
        return

    files_to_attach = []
    if msg.photo:
        files_to_attach.append((msg.photo[-1], ".jpg"))
    if msg.document and msg.document.mime_type and msg.document.mime_type.startswith("image/"):
        ext = ".jpg"
        if msg.document.file_name and "." in msg.document.file_name:
            ext = "." + msg.document.file_name.rsplit(".", 1)[1]
        files_to_attach.append((msg.document, ext))

    if not files_to_attach:
        return

    api = ManageEngineAPI()
    for media, ext in files_to_attach:
        tg_file = await media.get_file()
        with tempfile.NamedTemporaryFile(delete=False, suffix=ext) as tmp:
            tmp_path = Path(tmp.name)
        try:
            await tg_file.download_to_drive(custom_path=str(tmp_path))
            api.attach_file_to_request(str(request_id), str(tmp_path), note_text="Telegram image")
        finally:
            try:
                tmp_path.unlink(missing_ok=True)
            except Exception:
                pass


def _get_stt_model() -> WhisperModel:
    global _stt_model
    if _stt_model is None:
        _stt_model = WhisperModel(STT_MODEL_NAME, device="cpu")
    return _stt_model


async def _voice_to_text(update: Update) -> str:
    msg = update.effective_message
    if not msg:
        return ""

    media = msg.voice or msg.audio
    if not media:
        return ""

    tg_file = await media.get_file()
    suffix = ".ogg" if msg.voice else ".mp3"

    with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
        tmp_path = Path(tmp.name)

    try:
        await tg_file.download_to_drive(custom_path=str(tmp_path))
        model = _get_stt_model()
        segments, _info = model.transcribe(str(tmp_path), language="ru")
        text = " ".join(seg.text.strip() for seg in segments if seg.text and seg.text.strip()).strip()
        return text
    finally:
        try:
            tmp_path.unlink(missing_ok=True)
        except Exception:
            pass


async def _handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    del context
    msg = update.effective_message
    if not msg or not update.effective_chat or not update.effective_user:
        return

    chat_id = update.effective_chat.id
    topic_id = msg.message_thread_id or 0

    if chat_id != TARGET_CHAT_ID:
        return
    if TARGET_TOPIC_ID and topic_id != TARGET_TOPIC_ID:
        return

    text = (msg.text or msg.caption or "").strip()
    if not text and (msg.voice or msg.audio):
        try:
            text = (await _voice_to_text(update)).strip()
        except Exception:
            log.exception("Voice transcription failed")
            await msg.reply_text("Опишите проблему текстом, пожалуйста.")
            return

    if not text:
        await msg.reply_text("Опишите проблему текстом, пожалуйста.")
        return

    user_id = str(update.effective_user.id)
    user_label = _username(update)

    pending = _pending_clarification.get(user_id)
    had_pending = bool(pending)
    if pending:
        text = f"{pending} {text}".strip()
        _pending_clarification.pop(user_id, None)
    llm_is_it, llm_category_id, llm_conf = _classify_with_llm(text)
    log.info(
        "classification user=%s is_it=%s category=%s conf=%.2f",
        user_id,
        llm_is_it,
        llm_category_id,
        llm_conf,
    )

    # Полностью AI-режим: решение IT/non-IT принимает только модель.
    if llm_is_it is False:
        return
    if llm_is_it is None:
        # Classifier unavailable (timeout/provider issue): fail-closed, no incident creation.
        return
    if llm_conf < CLASSIFIER_CONFIDENCE:
        await msg.reply_text("С каким ПО или оборудованием проблема?")
        return

    category_id = llm_category_id or "612"

    request_id, status = process_message(user_id, user_label, text, category_id_override=category_id)

    if status == "created" and request_id:
        await _attach_message_images(update, str(request_id))
        await msg.reply_text(_build_created_text(str(request_id), user_label, int(user_id), text, category_id))
    elif status == "updated" and request_id:
        await _attach_message_images(update, str(request_id))
        await msg.reply_text(f"Добавлено к заявке №{request_id}")
    elif status == "clarification_needed":
        if had_pending:
            # Avoid endless loop: create as uncategorized after second attempt.
            request_id2, status2 = process_message(user_id, user_label, text, category_id_override="612")
            if status2 == "created" and request_id2:
                await _attach_message_images(update, str(request_id2))
                await msg.reply_text(_build_created_text(str(request_id2), user_label, int(user_id), text, "612"))
                return
            if status2 == "updated" and request_id2:
                await _attach_message_images(update, str(request_id2))
                await msg.reply_text(f"Добавлено к заявке №{request_id2}")
                return
        _pending_clarification[user_id] = text
        await msg.reply_text("С каким ПО или оборудованием проблема?")
    elif status in {"ignored_offtopic", "ignored_bot_mention", "ignored_support_staff", "greeting"}:
        return
    else:
        await msg.reply_text("⚠️ Не удалось создать заявку. Обратитесь к администратору.")


def main() -> None:
    if not TG_TOKEN:
        raise RuntimeError("DISPATCHER_TELEGRAM_BOT_TOKEN is required")
    if TARGET_CHAT_ID == 0:
        raise RuntimeError("DISPATCHER_TARGET_CHAT_ID is required")

    app = Application.builder().token(TG_TOKEN).build()
    app.add_handler(MessageHandler(filters.ALL & ~filters.COMMAND, _handle_message))

    log.info("Dispatcher bot started: chat_id=%s topic_id=%s", TARGET_CHAT_ID, TARGET_TOPIC_ID)
    app.run_polling()


if __name__ == "__main__":
    main()
